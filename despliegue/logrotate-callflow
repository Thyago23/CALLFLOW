# Rotación de los registros de CALLFLOW (con LOGS_ROTACION=externa en el .env). Instalar:
#   sudo cp despliegue/logrotate-callflow /etc/logrotate.d/callflow
# TI › Servidor lee errores.jsonl y los rotados (errores.jsonl.1 …); por eso no se comprime el primero.
/datos/logs/*.jsonl /datos/logs/*.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    su callflow callflow
    create 0640 callflow callflow
}
