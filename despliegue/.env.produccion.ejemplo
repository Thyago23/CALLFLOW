# .env del servidor Linux. Copiar como /srv/callflow/.env y dejarlo con permisos 600 (dueño callflow).
# Ver despliegue/INSTALACION.md. NUNCA se sube a git.

# Nueva para el servidor, o la misma de la PC actual (así nadie pierde la sesión el día del cambio):
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambie-esto
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=callflow.EJEMPLO.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://callflow.EJEMPLO.com
# Nginx manda todo a HTTPS; esto lo repite en Django por si alguien entra directo.
DJANGO_SSL_REDIRECT=True
# Activar HSTS (31536000) recién cuando el HTTPS funcione bien en todas las PCs. 0 = apagado.
DJANGO_HSTS_SEGUNDOS=0

# Base de datos (local). Las contraseñas de admin las agrega scripts/crear_bd.sh.
DB_NAME=callflow
DB_USER=callflow_app
DB_PASSWORD=cambie-esto
DB_HOST=localhost
DB_PORT=5432
DB_CONNECT_TIMEOUT=5
DB_CONN_MAX_AGE=60

# LA MISMA de la PC actual. Si cambia, los números de tarjeta ya guardados no se pueden leer nunca más.
CLAVE_TARJETAS=cambie-esto

# Las mismas de la PC actual (así los navegadores no tienen que volver a activar las push).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=mailto:ti@EJEMPLO.com

# Carpetas del servidor
MEDIA_ROOT=/datos/media
LOGS_DIR=/datos/logs
CARPETA_RESPALDOS=/respaldos/callflow
LOGS_ROTACION=externa

# Detrás de Nginx: toma la IP real de cada PC (TI › Conectados, límite de peticiones) y el HTTPS de X-Forwarded-Proto.
TI_PROXY_CONFIABLE=True
# Contadores del límite de peticiones compartidos entre los procesos de Gunicorn (carpeta que crea systemd).
DJANGO_CACHE=archivos
CACHE_DIR=/var/cache/callflow
# Cada cuántos segundos la campana consulta avisos.
CAMPANA_SEGUNDOS=20
