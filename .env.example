# Copie este archivo como .env y complete los valores. El .env NO se sube a git.
DJANGO_SECRET_KEY=cambie-esto
DJANGO_DEBUG=True
# Para abrir la app desde otra computadora de la red, agregue la IP de ESTA computadora
# (p. ej. localhost,127.0.0.1,192.168.100.83) y arranque con: python manage.py runserver 0.0.0.0:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Con la misma IP y puerto, con http:// (p. ej. http://192.168.100.83:8000). Vacío si solo usa localhost.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de datos. Para usar la base compartida de otra computadora, ponga su IP en DB_HOST
# y la misma contraseña de callflow_app que tiene esa computadora.
DB_NAME=callflow
DB_USER=callflow_app
DB_PASSWORD=cambie-esto
DB_HOST=localhost
DB_PORT=5432
DB_CONNECT_TIMEOUT=5

# Clave Fernet (si comparten la base, debe ser LA MISMA en las dos computadoras) para cifrar números de tarjeta: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLAVE_TARJETAS=cambie-esto

# Notificaciones push del navegador. Genérelas con: python manage.py generar_claves_push --guardar
# (solo funcionan con HTTPS o en localhost). Sin ellas, los avisos dentro del sistema funcionan igual.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=mailto:soporte@callflow.local

# Carpeta de archivos subidos (CV, contratos, fotos, adjuntos, actas). Vacío = carpeta media\ del proyecto.
# Si esta PC usa la base de otra computadora, apunte a la carpeta compartida de esa computadora
# (p. ej. \192.168.100.83\callflow-media) para que todos vean los mismos archivos. En el servidor: /datos/media
MEDIA_ROOT=
